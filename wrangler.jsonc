{
  // Static, server-less deploy: the whole app (including GLB->USDZ conversion)
  // runs in the browser. This is an assets-only Worker — no `main` script.
  "name": "gltf2usdz",
  "compatibility_date": "2026-06-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Serve on the production domain. The zone must already exist in the account;
  // `wrangler deploy` provisions the custom-domain DNS + route.
  "routes": [{ "pattern": "gltf2usdz.online", "custom_domain": true }]
}
